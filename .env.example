# 仅服务端读取，切勿提交真实密钥。未配置时可完整体验离线练习。
AI_PROVIDER=mimo
AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-flash
AI_VISION_MODEL=mimo-v2.6-flash
VISION_TIMEOUT_SECONDS=90
DATABASE_PATH=data/ai-teacher.sqlite3
AI_TIMEOUT_SECONDS=60

# 正常运行保持登录与身份隔离；false 仅用于旧业务临时测试。
AUTH_REQUIRED=true
# 云端私人部署可设false，只允许迁移过来的现有学生登录。
REGISTRATION_ENABLED=true
REGISTRATION_REQUIRES_INVITE=false
# 可选：离线客户端的远程题库源；只读凭证只存后端，不下发学生页面。
CONTENT_SOURCE_URL=
CONTENT_SOURCE_KEY=
# 发布端只读更新凭证，至少32字符；未配置时仅管理员可下载更新包。
CONTENT_FEED_KEY=
